#!/usr/bin/env bash
# Block pushes that would fail CI. GitHub Actions is disabled for this
# account, so these gates run locally instead. Enable once per checkout with:
#   git config core.hooksPath .githooks
# Bypass in an emergency with: git push --no-verify
set -euo pipefail

remote="${1:-}"
pushes_commits=false
head_sha="$(git rev-parse HEAD)"

while read -r local_ref local_sha _remote_ref _remote_sha; do
  # An all-zero local SHA is a branch deletion, which needs no checks.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi

  # An annotated tag arrives as the tag object's SHA; the commit it names is
  # what the gates would check.
  if ! commit_sha="$(git rev-parse --verify --quiet "${local_sha}^{commit}")"; then
    echo "pre-push: $local_ref does not name a commit." >&2
    exit 1
  fi

  # A tag on a commit the remote already has adds no code, so there is
  # nothing to check: the release tag on main's merge commit, say.
  if [[ "$local_ref" == refs/tags/* && -n "$remote" ]] &&
    [[ -n "$(git branch --remotes --contains "$commit_sha" --list "$remote/*")" ]]; then
    continue
  fi

  # The gates check the working tree, so they only vouch for HEAD.
  if [[ "$commit_sha" != "$head_sha" ]]; then
    echo "pre-push: $local_ref is not the checked-out commit; check it out" >&2
    echo "and push again so the gates run against it." >&2
    exit 1
  fi

  pushes_commits=true
done

if [[ "$pushes_commits" == false ]]; then
  exit 0
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "pre-push: uncommitted changes would be checked instead of the pushed" >&2
  echo "commits; commit or stash them first." >&2
  exit 1
fi

# git diff misses new files, but the gates still lint and test them.
if [[ -n "$(git ls-files --others --exclude-standard -- src tests scripts examples)" ]]; then
  echo "pre-push: untracked files under src/, tests/, scripts/, or examples/" >&2
  echo "would be checked but not pushed; commit, stash, or remove them first." >&2
  exit 1
fi

echo "pre-push: running CI gates (scripts/check.sh)"

if ! "$(git rev-parse --show-toplevel)/scripts/check.sh"; then
  echo "pre-push: gates failed; push blocked." >&2
  exit 1
fi
